{
  "default_port": "443",
  "access_log": false,
  "dial_timeout_ms": 5000,
  "sniff_timeout_ms": 5000,
  "dns_refresh_seconds": 30,
  "udp_idle_seconds": 60,
  "max_tcp_connections": 65536,
  "max_udp_sessions": 16384,
  "max_connections_per_ip": 4096,
  "max_pending_handshakes": 1024,
  "udp_queue_bytes": 268435456,
  "rules": [
    {
      "listen": "443",
      "domain": "app.example.com",
      "target": "home.example.net:443",
      "protocol": "both",
      "note": ""
    },
    {
      "listen": "443",
      "domain": "*.example.org",
      "target": "192.0.2.20:8443",
      "protocol": "both",
      "note": ""
    }
  ],
  "auto_capacity": true
}
